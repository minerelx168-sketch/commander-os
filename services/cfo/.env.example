# === CFO Command — Environment Configuration ===

# Claude API key (required for AI briefs / chat / self-learning).
# Get one at https://console.anthropic.com/
# The system still runs WITHOUT a key using a deterministic fallback brief,
# but AI narrative, chat, and self-learning require this.
ANTHROPIC_API_KEY=

# Claude model id (default: claude-opus-4-8)
CFO_MODEL=claude-opus-4-8

# HTTP port for the dashboard + API
PORT=3000

# Autonomous monitoring schedule (cron). Default: every day at 08:00.
# Set to "off" to disable the scheduler.
CFO_MONITOR_CRON=0 8 * * *

# --- Financial safety thresholds (used by the alert engine) ---
# Minimum safe cash balance per project (THB). Below this = red flag.
CFO_MIN_CASH_BUFFER=100000
# Cash-flow projection horizon in days
CFO_PROJECTION_DAYS=30
# Cost-spike alert: flag a category up more than this % vs the prior period
CFO_COST_SPIKE_PCT=20
# Overdue days after which a receivable is treated as at-risk (NPL bucket)
CFO_NPL_DAYS=30
