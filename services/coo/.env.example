# ─────────────────────────────────────────────────────────────
# COO Command — ตัวอย่างการตั้งค่า (คัดลอกเป็น .env แล้วแก้ค่า)
# ─────────────────────────────────────────────────────────────

# ── Server ──
PORT=8080
HOST=0.0.0.0

# ── การเชื่อมต่อ LLM (Manus) ──
# LLM_PROVIDER: "mock" = ใช้ตัววางแผนภายใน(autonomous ทันที ไม่ต้องมี key)
#               "manus" = เชื่อม Manus / OpenAI-compatible endpoint
LLM_PROVIDER=mock

# ใช้เมื่อ LLM_PROVIDER=manus
# รองรับ endpoint แบบ OpenAI Chat Completions (Manus, OpenRouter, ฯลฯ)
MANUS_API_URL=https://api.manus.im/v1/chat/completions
MANUS_API_KEY=
MANUS_MODEL=manus-1

# จำนวนรอบสูงสุดของ agent loop ต่อหนึ่งคำสั่ง
AGENT_MAX_STEPS=8

# ── ความปลอดภัย ──
# คีย์สำหรับยืนยัน request ที่เข้ามาจาก Manus (ส่งผ่าน header x-coo-key)
COO_API_KEY=change-me

# ── Webhook รายงานผลแบบอซิงโครนัส (ไม่บังคับ) ──
# ถ้าตั้งค่าไว้ ระบบจะ POST "COO Operational Brief" ไปที่นี่เมื่อทำงานเสร็จ
REPORT_WEBHOOK_URL=

# ── เขตเวลา (สำคัญมากต่อความถูกต้องของวัน/เวลา) ──
TZ=Asia/Bangkok
