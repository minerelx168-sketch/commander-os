# --- LLM providers ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MANUS_API_KEY=
MANUS_API_URL=https://api.manus.im/v1/chat/completions

# --- Documents: Google Drive (service account) ---
# 1) Google Cloud Console -> create service account -> download JSON key
# 2) share the target Drive folder with the service account's email
GDRIVE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
GDRIVE_FOLDER_ID=

# --- Documents: LINE Messaging API ---
# LINE Developers console -> Messaging API channel
# webhook URL: https://<your-tunnel>/api/line/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
