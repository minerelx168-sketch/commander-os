# --- LLM providers ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MANUS_API_KEY=
# Manus native task API base (agent tasks; no trailing /chat/completions)
MANUS_API_URL=https://api.manus.im/v1

# Z.AI (GLM) — OpenAI-compatible; get key at https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
ZAI_API_URL=https://api.z.ai/api/paas/v4/chat/completions
# ZAI_MODEL=glm-4.6

# Claude model override (default claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# --- Web research (Round 0) ---
# The board searches the open internet and screens the hits before debating.
# First key present wins; with none set it falls back to keyless DuckDuckGo.
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# set to 0 to leave the "สืบข้อมูลจากอินเทอร์เน็ต" toggle off by default
WEB_RESEARCH_DEFAULT=1

# --- Documents: Google Drive (service account) ---
# 1) Google Cloud Console -> create service account -> download JSON key
# 2) share the target Drive folder with the service account's email
GDRIVE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
GDRIVE_FOLDER_ID=

# --- Documents: LINE Messaging API ---
# LINE Developers console -> Messaging API channel
# webhook URL: https://<your-tunnel>/api/line/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
